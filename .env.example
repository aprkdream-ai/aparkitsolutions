# ---- Application ----
APP_NAME="APARK IT Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Canonical production URL (scheme + host used for canonical tags, sitemap, and redirects)
APP_URL=https://www.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# No database is required. File drivers work on shared hosting.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Site behaviour ----
# Allow search engines (set false on staging)
SITE_INDEXABLE=true
# Redirect http→https and non-canonical host → APP_URL host. Enable once SSL works.
FORCE_CANONICAL_URL=true
# Only when behind a proxy/CDN (e.g. Cloudflare): comma-separated IPs or *
TRUSTED_PROXIES=
CONTENT_SHOW_DRAFTS=false
LEGAL_REVIEWED=false
LEGAL_UPDATED=2026-10-19
# SITE_LOGO=assets/img/brand/logo.svg

# ---- Company contact details (leave empty to hide) ----
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_ADDRESS=
CONTACT_MAP_EMBED_URL=
CONTACT_HOURS=
# Where contact form enquiries are sent (defaults to CONTACT_EMAIL)
CONTACT_RECIPIENT=
# Also keep a copy of each enquiry in storage/app/private/contact/submissions.jsonl
CONTACT_STORE_SUBMISSIONS=true

# ---- Social profiles (full URLs, leave empty to hide) ----
SOCIAL_LINKEDIN=
SOCIAL_GITHUB=
SOCIAL_X=
SOCIAL_FACEBOOK=
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=

# ---- SEO ----
SEO_TWITTER_HANDLE=
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=
# Comma-separated regions served, only if confirmed (e.g. "India, United Kingdom")
SEO_AREA_SERVED=
BLOG_PER_PAGE=9

# ---- Mail (SMTP from your hosting provider, e.g. Hostinger: smtp.hostinger.com:465 ssl) ----
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
