# ---- Application ----
APP_NAME="APARK IT Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Canonical production URL (scheme + host used for canonical tags, sitemap, and redirects)
APP_URL=https://aparkitsolutions.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# No database is required. File drivers work on shared hosting.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Site behaviour ----
# Allow search engines (set false on staging)
SITE_INDEXABLE=true
# Redirect http→https and non-canonical host → APP_URL host. Enable once SSL works.
FORCE_CANONICAL_URL=true
# Only when behind a proxy/CDN (e.g. Cloudflare): comma-separated IPs or *
TRUSTED_PROXIES=*
CONTENT_SHOW_DRAFTS=false
LEGAL_REVIEWED=false
LEGAL_UPDATED=2026-10-19
# SITE_LOGO=assets/img/brand/logo.svg

# ---- Company contact details (leave empty to hide) ----
CONTACT_EMAIL=info@aparkitsolutions.com
CONTACT_PHONE="+91 90094 34118"
CONTACT_WHATSAPP=919009434118
CONTACT_ADDRESS="College Road, Bilaunji, Waidhan, Madhya Pradesh 486886, India"
CONTACT_MAP_EMBED_URL="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3495.7115784543166!2d82.61593977996414!3d24.075119120689106!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x398f373e104e63a3%3A0xf0b9d090dd379fdc!2sAPARK%20IT%20Solutions!5e1!3m2!1sen!2sin!4v1792429900087!5m2!1sen!2sin"
# Structured address (LocalBusiness schema)
ADDRESS_STREET="College Road, Bilaunji"
ADDRESS_LOCALITY=Waidhan
ADDRESS_REGION="Madhya Pradesh"
ADDRESS_POSTAL_CODE=486886
ADDRESS_COUNTRY=IN
ADDRESS_LAT=24.0751191
ADDRESS_LNG=82.6159398
CONTACT_HOURS=
# Where contact form enquiries are sent (defaults to CONTACT_EMAIL)
CONTACT_RECIPIENT=info@aparkitsolutions.com
# Also keep a copy of each enquiry in storage/app/private/contact/submissions.jsonl
CONTACT_STORE_SUBMISSIONS=true
# Send a confirmation email to the person who submitted the form
CONTACT_AUTOREPLY=true

# ---- Social profiles (full URLs, leave empty to hide) ----
SOCIAL_LINKEDIN=https://www.linkedin.com/company/aparkitsolutions
SOCIAL_GITHUB=
SOCIAL_X=https://twitter.com/aparkitsolutions
SOCIAL_FACEBOOK=https://www.facebook.com/aparkitsolutions
SOCIAL_INSTAGRAM=
SOCIAL_YOUTUBE=

# ---- SEO ----
# Google Analytics 4 (loads only when SITE_INDEXABLE=true)
GA_MEASUREMENT_ID=G-ZMXXSE5Y06
CONTACT_LANGUAGES="English, Hindi"
SEO_TWITTER_HANDLE=
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=
# Comma-separated regions served, only if confirmed (e.g. "India, United Kingdom")
SEO_AREA_SERVED=India
BLOG_PER_PAGE=9

# ---- Mail: Google Workspace SMTP (use a Google App Password, never the account password) ----
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=info@aparkitsolutions.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@aparkitsolutions.com
MAIL_FROM_NAME="${APP_NAME}"
